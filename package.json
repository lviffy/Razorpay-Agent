{
  "name": "zapai-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "description": "ZapAI — Autonomous AI-Native Commerce Monorepo",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "bun run --filter=@zapai/api start",
    "start:web": "bun run --filter=@zapai/web start",
    "migrate": "bun run --filter=@zapai/database db:migrate",
    "db:migrate": "bun run --filter=@zapai/database db:migrate",
    "db:clean": "bun run --filter=@zapai/database db:clean",
    "db:seed": "bun run --filter=@zapai/database db:seed",
    "test": "bun test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  }
}
