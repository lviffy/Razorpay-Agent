# ── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ── Razorpay (test mode) ─────────────────────────────────────────────────────
# Standard Payment Links only — UPI Payment Links are NOT supported in test mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_any_random_string

# ── Neon DB ───────────────────────────────────────────────────────────────────
# Copy from: Neon console → your project → Connection String → pooled
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/agentbridge?sslmode=verify-full

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway injects REDIS_URL automatically when Redis plugin is added
# For local dev, use: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
# Railway gives you this URL — use it as webhook URL in Meta & Razorpay dashboards
APP_URL=https://your-app.up.railway.app
PORT=3000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_signing_secret_here

# ── x402 ──────────────────────────────────────────────────────────────────────
# Secret used to HMAC-sign x402 challenges
X402_SIGNING_SECRET=choose_a_long_random_secret_here
